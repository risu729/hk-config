/// Dogfood the in-repo preset while developing. Consumer repos pin a release URL instead.
amends "./presets.pkl"

import "./helpers.pkl"

local picked =
  helpers.pick(new Listing {
    "hk-validate"
    "pkl"
    "pkl-format"
    "github-actions"
    "lychee"
  })

steps = (picked) {
  ["hk-validate"] = (picked["hk-validate"]) {
    // The evaluator drops the inherited command when this custom step is amended.
    // Keep validation active until https://github.com/risu729/hk-config/issues/124 is fixed.
    check = "hk validate"
    glob =
      List(
        "hk.pkl",
        "hk.local.pkl",
        ".config/hk.pkl",
        ".config/hk.local.pkl",
        "presets.pkl",
        "helpers.pkl",
      )
  }
}
